# Copy to .env and adjust. Real environment variables override this file.

PORT=3000
HOST=0.0.0.0
# Address staff use to reach the system (used in email links)
PUBLIC_URL=https://visitors.example.org
TZ=Africa/Lagos
ORG_NAME=UN Common Services

# Set to true when served over HTTPS (behind a reverse proxy)
SECURE_COOKIES=false
SESSION_HOURS=12

# Database file (SQLite). Back this file up daily.
DB_FILE=./data/vms.sqlite

# Physical visitor tags: 001..300 and VIP tags V01..V30
TAG_POOL_SIZE=300
TAG_PREFIX=
VIP_TAG_POOL_SIZE=30
VIP_TAG_PREFIX=V

# Visitor types that must be approved by a Common Services Manager
APPROVAL_TYPES=contractor,walk_in
DEFAULT_VISIT_MINUTES=120
# Visitor personal data is anonymised after this many days
RETENTION_DAYS=180

# Email (host arrival alerts, visitor invitations, approval requests).
# Leave SMTP_HOST empty to record emails in Admin → Reports → Email log without sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UN Common Services Visitor Desk <visitors@example.org>"
